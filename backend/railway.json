{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements/prod.txt && python manage.py collectstatic --no-input"
  },
  "deploy": {
    "preDeployCommand": "python manage.py migrate --no-input",
    "startCommand": "gunicorn bledger.wsgi:application --bind 0.0.0.0:$PORT --workers 3",
    "healthcheckPath": "/api/v1/health/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
