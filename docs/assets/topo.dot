digraph topo {
  rankdir=TB; bgcolor="white"; compound=true;
  graph [fontname="Helvetica", fontsize=12, ranksep=0.6, nodesep=0.5];
  node  [fontname="Helvetica", fontsize=10, style="filled", penwidth=1];

  subgraph cluster_standalone {
    label="MODE 2 — STANDALONE  (one shop, fully offline)"; style="rounded,filled"; fillcolor="#eff6ff"; color="#3b82f6"; fontsize=13;
    sa_dev [label="Shop device\nDjango + React (standalone.py)\nSYNC_ENABLED = False", shape=box, fillcolor="#bfdbfe"];
    sa_db  [label="SQLite  db.sqlite3", shape=cylinder, fillcolor="#fde68a"];
    sa_pr  [label="80mm PDF receipt", shape=note, fillcolor="#fff7ed"];
    sa_dev->sa_db; sa_dev->sa_pr;
  }

  subgraph cluster_connected {
    label="MODE 1 — CONNECTED  (multi-branch; operates offline, syncs when online)"; style="rounded,filled"; fillcolor="#fef2f2"; color="#ef4444"; fontsize=13;

    subgraph cluster_hq {
      label="Head office (Railway)"; style="rounded,filled"; fillcolor="#fee2e2"; color="#b91c1c";
      cloud [label="Django (production.py)\ngunicorn · WhiteNoise · HSTS", shape=box, fillcolor="#fecaca"];
      pg    [label="PostgreSQL", shape=cylinder, fillcolor="#fca5a5"];
      hqdash[label="HQ dashboard\ncross-branch rollup", shape=box, fillcolor="#fecaca"];
      cloud->pg; hqdash->cloud;
    }

    subgraph cluster_b1 {
      label="Branch till A"; style="rounded,filled"; fillcolor="#dbeafe"; color="#1d4ed8";
      b1 [label="Django + React (branch.py)\nSYNC_ENABLED = True", shape=box, fillcolor="#bfdbfe"];
      b1db [label="SQLite", shape=cylinder, fillcolor="#fde68a"]; b1->b1db;
    }
    subgraph cluster_b2 {
      label="Branch till B"; style="rounded,filled"; fillcolor="#dbeafe"; color="#1d4ed8";
      b2 [label="Django + React (branch.py)\nSYNC_ENABLED = True", shape=box, fillcolor="#bfdbfe"];
      b2db [label="SQLite", shape=cylinder, fillcolor="#fde68a"]; b2->b2db;
    }

    b1->cloud [label="push outbox →\n← pull catalogue", style=dashed, color="#dc2626", fontsize=9];
    b2->cloud [label="push / pull", style=dashed, color="#dc2626", fontsize=9];
  }
}
