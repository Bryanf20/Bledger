# Copy to .env and fill in. Loaded via django-environ in settings/base.py.

# Which settings module is active is set via DJANGO_SETTINGS_MODULE,
# not via this file — but DEPLOYMENT_MODE is read at runtime by
# apps/core/middleware.py to tag requests/responses.
# standalone | connected — read at runtime by apps/core/middleware.py
# to tag requests/responses.
DEPLOYMENT_MODE=standalone

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Standalone mode (SQLite) — only SQLITE_PATH is used.
SQLITE_PATH=db.sqlite3

# Connected mode (Phase 2 — PostgreSQL on Railway/DigitalOcean).
POSTGRES_DB=bledger
POSTGRES_USER=bledger
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# This branch's identifier, used by core.middleware to stamp BRANCH_ID
# on every request in standalone mode (single-branch-per-install).
BRANCH_ID=HQ

# ---------------------------------------------------------------------------
# Phase 2 — CLOUD (Mode 1 "connected") deploy, e.g. Railway.
# Active when DJANGO_SETTINGS_MODULE=bledger.settings.production. See
# docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
# Railway's Postgres plugin injects DATABASE_URL automatically; connected.py
# prefers it over the discrete POSTGRES_* vars above.
# DATABASE_URL=postgres://user:pass@host:5432/bledger
# Public HTTPS origin(s) of the cloud — required for allowed hosts + CSRF.
# DJANGO_ALLOWED_HOSTS=bledger-hq.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bledger-hq.up.railway.app
# DJANGO_CORS_ALLOWED_ORIGINS=https://bledger-hq.up.railway.app
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Phase 2 — BRANCH DEVICE (Mode 1 "branch"). SQLite locally + sync on.
# Active when DJANGO_SETTINGS_MODULE=bledger.settings.branch.
# ---------------------------------------------------------------------------
# Base URL of head office this device pushes/pulls against.
# CLOUD_API_BASE_URL=https://bledger-hq.up.railway.app
# SYNC_PUSH_INTERVAL_SECONDS=30
